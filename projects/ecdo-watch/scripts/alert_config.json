    "magnetometer_down": {
      "enabled": true,
      "email": false,
      "webhook": true,
      "template": "Magnetometer data unavailable for {failed_stations}. Status: {status}"
    },
    "watch_level_triggered": {
      "enabled": true,
      "email": true,
      "webhook": true,
      "template": "WATCH LEVEL ELEVATED: {previous_badge} -> {current_badge} (coherence score: {score}). Multi-channel coherent anomaly detected."
    }
  },
  "quiet_hours": {
    "enabled": false,
    "start_utc": 22,
    "end_utc": 6,
    "description": "Do not send alerts during these hours (UTC)"
