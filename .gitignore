node_modules
*.timestamp-*.mjs
package-lock.json
nul
*.log
*.aux
*.toc

# Atomic-write leftover fragments from publish pipeline crashes
*.tmp.*

# Internal portfolio analysis — Dropbox-versioned, not for public repo.
# PODs, PSRs, decisions doc, templates all live here as internal coordination
# artifacts. The two artemis_ii files that were tracked before this rule are
# left as-is (their old public versions stay on the repo; local edits stay
# local). To intentionally commit something from this dir, use `git add -f`.
projects/project-documents/

# Real portfolio exports — personal holdings, never public. The cash-bubble app
# embeds its scrubbed DEMO inline, so ignoring these does not affect the site.
projects/cash-bubble/cash-bubble-portfolio-*.json
projects/cash-bubble/test-portfolio.json

# Personal ETM task-data snapshots — dated exports of real task lists (titles,
# notes, ratings). Never public. The live app data (eisenhower-app/**/data/) is
# already untracked; these dated snapshots were tracked before this rule and are
# being removed from the repo. Local copies stay in Dropbox.
projects/eisenhower-task-manager/eisenhower-tasks-*.json

# Claude Code local settings (machine-specific permissions/config).
projects/eisenhower-task-manager/.claude/settings.local.json
